{
  "name": "cold-egg/lscache-typo3",
  "type": "typo3-cms-extension",
  "description": "LiteSpeed Cache integration for TYPO3",
  "license": "GPL-2.0-or-later",
  "keywords": ["typo3", "litespeed", "cache"],
  "homepage": "https://github.com/Code-Egg/lscache-typo3",
  "support": {
    "issues": "https://github.com/Code-Egg/lscache-typo3/issues"
  },
  "authors": [
    {
      "name": "Egg",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "typo3/cms-core": ">=12.4"
  },
  "autoload": {
    "psr-4": {
      "LiteSpeed\\Lscache\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "lscache"
    }
  },
  "config": {
    "sort-packages": true
  }
}
